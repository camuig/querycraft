{
  "name": "query-craft",
  "private": true,
  "version": "0.4.0",
  "description": "Fast cross-platform desktop client for MySQL, MariaDB, PostgreSQL, SQL Server, ClickHouse, SQLite, Redis and Valkey in the spirit of DataGrip",
  "license": "Apache-2.0",
  "author": "camuig",
  "repository": {
    "type": "git",
    "url": "https://github.com/camuig/querycraft.git"
  },
  "bugs": {
    "url": "https://github.com/camuig/querycraft/issues"
  },
  "homepage": "https://github.com/camuig/querycraft#readme",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "icons": "rsvg-convert -w 1024 -h 1024 src/assets/logo-icon.svg -o /tmp/querycraft-icon.png && tauri icon /tmp/querycraft-icon.png && rm -rf src-tauri/icons/android src-tauri/icons/ios"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.11.0",
    "@codemirror/search": "^6.5.0",
    "@codemirror/state": "^6.7.5",
    "@codemirror/theme-one-dark": "^6.1.0",
    "@codemirror/view": "^6.43.12",
    "@lezer/highlight": "1.2.3",
    "@tanstack/react-virtual": "^3.14.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.0",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-fs": "^2.5.0",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-resizable-panels": "^4.12.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.1"
  }
}
